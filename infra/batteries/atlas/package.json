{
  "name": "@3pt/battery-atlas",
  "version": "0.0.1",
  "private": true,
  "description": "Battery: MongoDB Atlas Sandbox. Provisions the database, the eight collections, indexes, and the vector index over transcripts. Supplies the real Store.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "provision": "node dist/provision.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@3pt/core": "workspace:*",
    "mongodb": "^6.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2"
  }
}
