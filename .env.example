# 3PT · every key the monorepo reads. Copy to .env (gitignored). Never commit .env.
# Loaded by the harness CLI, the API, the worker, and every infra/ battery via process.env.

# ---- MongoDB Atlas (required: every stateful thing goes through the Hackathon Sandbox) ----
ATLAS_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/3pt   # connection string for the Sandbox cluster
ATLAS_DB=3pt                     # database name; collections in infra/batteries/atlas/schema.ts
ATLAS_PROJECT_ID=                # Atlas project id (for the atlas battery to create indexes over the Admin API)
ATLAS_PUBLIC_KEY=                # Atlas programmatic API key pair (atlas battery only; optional if indexes are made by hand)
ATLAS_PRIVATE_KEY=

# ---- Embeddings (Voyage AI via MongoDB; 200M tokens per participant) ----
VOYAGE_API_KEY=                  # dashboard.voyageai.com → API keys

# ---- Model routing (one key, planner / builder / instrumenter across models) ----
OPENROUTER_API_KEY=              # code arrives by email

# ---- Tracing / measurement (Instrument stage) ----
LANGSMITH_API_KEY=               # $50 credits via the Airtable form (docs/04-resources.md)
LANGSMITH_PROJECT=3pt

# ---- Repo battery (instantiates repos, worktrees, tags; checkpoints are git-native) ----
GITHUB_TOKEN=                    # fine-grained, repo scope; used by infra/batteries/repo

# ---- Blob / artifact batteries (image bytes and build artifacts) ----
BLOB_BACKEND=gridfs              # gridfs | r2 | fs. gridfs keeps bytes inside the Sandbox (eligibility-safe)
BLOB_FS_ROOT=./.blob             # when BLOB_BACKEND=fs
CLOUDFLARE_API_TOKEN=            # when BLOB_BACKEND=r2, and for the worker deploy (harness/apps/worker)
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET=3pt-media

# ---- Signals battery (kernel witness on the box; infra/batteries/signals, docs/20-kernel-signals.md) ----
SIGNALS_DB=                      # SQLite WAL store; default .signals/signals.db here, /var/lib/3pt/signals.db on the box
SIGNALS_SENSORS=                 # comma list of exec,exit,open,connect (default: all)
SIGNALS_SINK=                    # atlas | file | none; default atlas when ATLAS_URI is set, else file
SIGNALS_FILE_SINK=               # JSONL path for SIGNALS_SINK=file (default .signals/drain.jsonl)
SIGNALS_DRAIN_MS=                # drain interval, default 30000
SIGNALS_PLUGIN_DIR=              # watched plugin directory, default infra/batteries/signals/plugins
SIGNALS_MEDIA_PREFIXES=          # comma list; opens under these are media (default /opt/3pt/data,/opt/3pt/.blob)
SIGNALS_STRIP=                   # comma list of attrs dropped before the store, e.g. cgroup,uid
SIGNALS_SAMPLE=                  # per-kind rates, e.g. open=0.1,exit=0.2 (media opens and findings are never sampled out)
SIGNALS_MARKER=                  # JSON {stage, iteration} the harness writes while it runs (default /opt/3pt/.install-loop/stage.json)
SIGNALS_ITERATION=               # iteration when there is no marker (default 0)
SIGNALS_RETENTION_DAYS=          # rows older than this and already drained are pruned (default 7)

# ---- Harness runtime ----
THREEPT_HARNESS=claude-code      # claude-code | kiro | codex — which build harness the Build stage wraps
THREEPT_TURN_BUDGET=6            # builder ↔ instrumenter turns before Build yields to Instrument
THREEPT_API_URL=http://127.0.0.1:8787   # where the surfaces (pwa, web, macos) reach harness/apps/api
