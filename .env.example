# 3PT · every key the monorepo reads. Copy to .env (gitignored). Never commit .env.
# Loaded by the harness CLI, the API, the worker, and every infra/ battery via process.env.

# ---- MongoDB Atlas (required: every stateful thing goes through the Hackathon Sandbox) ----
ATLAS_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/3pt   # connection string for the Sandbox cluster
ATLAS_DB=3pt                     # database name; collections in infra/batteries/atlas/schema.ts
ATLAS_ORG_ID=                    # the Sandbox org the hackathon email enrolled you in (Atlas → Organization → Settings)
ATLAS_PROJECT_ID=                # project inside that org; sandbox.sh finds or creates it by ATLAS_PROJECT_NAME (3pt) and writes it here
ATLAS_CLIENT_ID=                 # Atlas service account (preferred): drives the Atlas CLI in sandbox.sh and unlocks the atlas-* MCP tools
ATLAS_CLIENT_SECRET=
ATLAS_PUBLIC_KEY=                # or a programmatic API key pair (same uses); leave both empty to use `atlas auth login`
ATLAS_PRIVATE_KEY=
ATLAS_DBPASS=                    # db user password; sandbox.sh generates one on first `up --write`. No inline comment after a real value.
ATLAS_DBUSER=3pt                 # db user name (the console's quickstart names it <you>_db_user)
ATLAS_HOST=                      # cluster SRV host, e.g. cluster0.xxxxx.mongodb.net; with DBUSER+DBPASS this composes ATLAS_URI when ATLAS_URI is blank
ATLAS_CLUSTER=3pt                # cluster name; Patrick's console cluster is 3PT-Cluster (docs/17-atlas-setup-dossier.md §5)
ATLAS_TIER=M0                    # cluster tier for sandbox.sh (M0 free: 512 MB, 100 ops/s; scale with sandbox.sh scale FLEX|M10; hackathon credits cover up to M10)
ATLAS_OPEN_ACCESS=0              # 1 adds 0.0.0.0/0 to the access list (needed for the Cloudflare worker, which has no fixed IP)

# ---- Embeddings (Voyage AI via MongoDB; 200M tokens per participant) ----
VOYAGE_API_KEY=                  # dashboard.voyageai.com → API keys

# ---- Model routing (one key, planner / builder / instrumenter across models) ----
OPENROUTER_API_KEY=              # code arrives by email

# ---- Tracing / measurement (Instrument stage) ----
LANGSMITH_API_KEY=               # $50 credits via the Airtable form (docs/04-resources.md)
LANGSMITH_PROJECT=3pt

# ---- Repo battery (instantiates repos, worktrees, tags; checkpoints are git-native) ----
GITHUB_TOKEN=                    # fine-grained, repo scope; used by infra/batteries/repo

# ---- Blob / artifact batteries (image bytes and build artifacts) ----
BLOB_BACKEND=gridfs              # gridfs | r2 | fs. gridfs keeps bytes inside the Sandbox (eligibility-safe)
BLOB_FS_ROOT=./.blob             # when BLOB_BACKEND=fs
CLOUDFLARE_API_TOKEN=            # when BLOB_BACKEND=r2, and for the worker deploy (harness/apps/worker)
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET=3pt-media

# ---- Box battery (the VM the workload runs on; infra/batteries/box, docs/14-sandbox-provisioning.md) ----
BOX_PROFILE=3pt                  # Colima profile; `default` reuses the profile already on this machine (no new base image)
BOX_CPU=2
BOX_MEMORY=4                     # GiB
BOX_DISK=20                      # GiB allocated on first create (sparse)
BOX_ATLAS_LOCAL=0                # 1 also runs Atlas Local (Search + Vector Search offline) inside the box; ~1 GB image
BOX_REPO_MODE=sync               # sync = rsync this checkout into the box at /opt/3pt · clone = git clone BOX_REPO_URL@BOX_REPO_REF
BOX_REPO_URL=                    # when BOX_REPO_MODE=clone
BOX_REPO_REF=main
BOX_MIN_FREE_GB=2                # host free-disk floor before starting a profile; 8 (BOX_NEW_MIN_FREE_GB) before creating one
BOX_WORKER_SERVICE=1             # install and start the 3pt-worker systemd unit inside the box
WORKER_INTERVAL_MS=60000         # worker --watch tick interval

# ---- Harness runtime ----
THREEPT_HARNESS=claude-code      # claude-code | kiro | codex — which build harness the Build stage wraps
THREEPT_TURN_BUDGET=6            # builder ↔ instrumenter turns before Build yields to Instrument
THREEPT_API_URL=http://127.0.0.1:8787   # where the surfaces (pwa, web, macos) reach harness/apps/api
