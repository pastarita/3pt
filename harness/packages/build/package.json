{
  "name": "@3pt/build",
  "version": "0.0.1",
  "private": true,
  "description": "Build stage: a Strands harness, compiled from the current policy by @3pt/strands, runs the latest plan. Dry run without OPENROUTER_API_KEY.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": { "@3pt/core": "workspace:*", "@3pt/strands": "workspace:*", "@strands-agents/harness": "^0.1.1" },
  "devDependencies": { "typescript": "^5.9.2", "@types/node": "^22.18.0" }
}
