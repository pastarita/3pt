{
  "name": "@3pt/plan",
  "version": "0.0.1",
  "private": true,
  "description": "Plan stage: reads the latest checkpoint and measurements, selects a sprint mode, emits a spec and an evaluation plan.",
  "type": "module",
  "main": "./dist/index.js",
