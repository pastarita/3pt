  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": { "@3pt/core": "workspace:*" },
  "devDependencies": { "typescript": "^5.9.2", "@types/node": "^22.18.0" }
}
