{
  "name": "@3pt/worker",
  "version": "0.0.1",
  "private": true,
  "description": "Deployed worker system: consumes the Atlas jobs collection (index, transcribe, tier, migrate). Runs locally under node or deployed as a Cloudflare Worker.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": { "@3pt/core": "workspace:*", "@3pt/media": "workspace:*" },
  "devDependencies": { "typescript": "^5.9.2", "@types/node": "^22.18.0" }
}
