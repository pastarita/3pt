{
  "name": "@3pt/api",
  "version": "0.0.1",
  "private": true,
  "description": "Backend for the surfaces: read-mostly HTTP over Atlas state (checkpoints, policies, measurements, media index) plus a few verbs.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./handler": {
      "types": "./dist/handler.d.ts",
      "import": "./dist/handler.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@3pt/core": "workspace:*",
    "@3pt/battery-atlas": "workspace:*",
    "@3pt/setup": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "@types/node": "^22.18.0"
  }
}
